(( $# == 0 )) && {
	display_default_message
	ckxdb
}

case "$1" in
	-s|--start) ckxdb ;;

	-h|--help) display_help ;;

	-l|--license) display_license ;;

	-v|--version) display_version ;;

	--configure) config_gpg ;;

	-E|--encrypt) ckx_encrypt "$2" ;;

	-D|--decrypt) ckx_decrypt "$2" ;;

	*) display_error "$1" ;;
esac

exit "$?"

