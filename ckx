#!/usr/bin/env bash
#----------------------------------------------------------------------------------+
# Repo: https://github.com/ghostkill73/CryptoKnightX
# SPDX short identifier: MIT 
#----------------------------------------------------------------------------------+
# shellcheck disable=SC2155
# shellcheck disable=SC2164

LC_ALL=C
LANG=C

#set -eu
set -o pipefail

########################################################################################
#
# DEPS
#
########################################################################################

# Checking current bash version
case "$BASH_VERSION" in
	[4-9].*) : ;;
	*)
		printf 'ERROR: Bash version >=3.0 required, but you have %s\n' "$BASH_VERSION"
		exit 1
		;;
esac

command -v gpg &>/dev/null || { printf "'gpg' command not found.\n"; exit 1; }
command -v tar &>/dev/null || { printf "'tar' command not found.\n"; exit 1; }

########################################################################################
#
# CONFIGS
#
########################################################################################

declare SOFTWARE_NAME="CryptoKnightX"
declare SOFTWARE_VERSION="v0.0.8"

declare -r CKX_DEFAULT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/ckx"
declare -r CKX_CONFIGS_DIR="${CKX_DEFAULT_DIR}/config"
declare -r CKX_DATA_DIR="${CKX_DEFAULT_DIR}/data"

declare -ri TRUE=0
declare -ri FALSE=1
declare -ri ERROR=2

: "${CKX_ENTROPY_SIZE:=1M}"
: "${CKX_GPG_S2K_MODE:=3}"
: "${CKX_GPG_S2K_COUNT:=65011712}"
: "${CKX_GPG_S2K_DIGEST_ALGO:=SHA512}"
: "${CKX_GPG_S2K_CIPHER_ALGO:=TWOFISH}"

declare -ar CKX_GPG_ENC_OPTS=(
	--quiet
	--no-symkey-cache
	--compress-algo 0
	--s2k-mode "$CKX_GPG_S2K_MODE"
	--s2k-count "$CKX_GPG_S2K_COUNT"
	--s2k-digest-algo "$CKX_GPG_S2K_DIGEST_ALGO"
	--s2k-cipher-algo "$CKX_GPG_S2K_CIPHER_ALGO"
)
declare -ar CKX_GPG_DEC_OPTS=( --quiet --no-symkey-cache )

# See: https://www.gnupg.org/documentation/manuals/gnupg/Common-Problems.html
export GPG_TTY=$(tty)

########################################################################################
#
# UTILS
#
########################################################################################

msg() {
	printf '%b\n' "$@" >&2
}

error() {
	msg "\e[1;31m[!] $0: ${*}\e[m"
	return "$FALSE"
}

fatal() {
	msg "\e[1;41m[!!] $0: $@\e[m"
	exit "$ERROR"
}

success() {
	msg "\e[1;32m[*] ${*}\e[m"
}

warn() {
	msg "\e[1;33m[#] ${*}\e[m"
}

########################################################################################
#
# INFORMATION
#
########################################################################################

display_version() {
	msg "$SOFTWARE_NAME $SOFTWARE_VERSION"
	exit "$TRUE"
}

display_help() {
	msg \
	"$SOFTWARE_NAME $SOFTWARE_VERSION" \
	"A tool to encrypt files and manage encrypted directories." \
	"" \
	"Usage:" \
	"  $0 [OPTION] [FILE|DIRECTORY]" \
	"  $0" \
	"" \
	"Options:" \
	"  -e, --encrypt  encrypt a file or directory with GPG." \
	"  -d, --decrypt  decrypt a GPG-encrypted file." \
	"" \
	"  -l, --list-vaults  list available encrypted directories." \
	"" \
	"  -h, --help     display this help and exit." \
	"  -v, --version  output version information and exit." \
	"" \
	"Run '$0' without arguments to enter interactive mode." \
	"" \
	"Repository: https://github.com/ghostkill73/CryptoKnightX"
	exit "$TRUE"
}

########################################################################################
#
# GPG
#
########################################################################################

# TODO: Make this more secure
gpg_encrypt_dir() {
	local dir="$1"
	local out="$2"
	: "${out:=${dir}.ckx}"
	tar -cf - "$dir" | gpg --yes "${CKX_GPG_ENC_OPTS[@]}" -c -o "$out"
}

gpg_decrypt_dir() {
	local dir="$1"
	gpg --yes "${CKX_GPG_DEC_OPTS[@]}" -d "$dir" | tar -xf -
}

########################################################################################
#
# ckx database mode
#
########################################################################################

ckxdb_help() {
	msg \
	"SELECT -> select a directory     (SELECT 'dir')" \
	"CREATE -> create a new directory (CREATE 'dir')" \
	"REMOVE -> remove a directory     (REMOVE 'dir')" \
	"LIST   -> list directories" \
	"CLEAR  -> clear the screen" \
	"HELP   -> display this help message" \
	"EXIT   -> exit the program"
}

ckxdb_title() {
	msg \
	"\e[1;31m" \
	'             ▄▄█▀▀▀█▄█████▀ ▀███▀▀███▀   ▀██▀' \
	'           ▄██▀     ▀█ ██   ▄█▀    ███▄  ▄█' \
	'           ██▀       ▀ ██ ▄█▀       ▀██▄█▀' \
	'           ██          █████▄         ███' \
	'           ██▄         ██  ███      ▄█▀▀██▄' \
	'           ▀██▄     ▄▀ ██   ▀██▄   ▄█   ▀██▄' \
	'             ▀▀█████▀▄████▄   ███▄██▄▄  ▄▄███▄' \
	" a soldier's bravery is only recognized on the battlefield" \
	"               --||////[CRYPTOKNIGHTX]////>" \
	"\e[m"
}

ckxdb_decrypt() {
	local dir="$1"
	if gpg_decrypt_dir "$dir"; then
		success "$dir decrypted successfully."
	else
		error "An error occurred while decrypting $dir."
	fi
}

ckxdb_encrypt() {
	local dir="$1"
	dd if=/dev/random of="$dir"/.entropy bs="$CKX_ENTROPY_SIZE" count=1 &>/dev/null
	if gpg_encrypt_dir "$dir"; then
		success "$dir encrypted successfully."
	else
		error "An error occurred while encrypting $dir."
	fi
}

ckxdb_list() {
	local data

	for data in "$CKX_DATA_DIR"/*; {
		if [[ -d "$data" ]]; then
			msg "\e[1;31m[!] ${data##*/} (decrypted)\e[m"
		elif [[ -e "$data" ]]; then
			msg "\e[1;32m[+] ${data##*/}\e[m"
		fi
	}
}

ckxdb_cd() {
	local target="$1"

	[[ -d "$target" ]] && {
		CKXDB_BREAK=0
		return "$TRUE"
	}

	[[ -e "$target" ]] && {
		if ckxdb_decrypt "$target"; then
			CKXDB_BREAK=0
			return "$TRUE"
		else
			CKXDB_BREAK=1
			return "$FALSE"
		fi
	}

	warn "$target does not exist."
	return "$FALSE"
}

ckxdb_rm() {
	local target="$1"

	[[ -z "$target" ]] && {
		warn "Target name not provided."
		return "$FALSE"
	}

	[[ -d "$target" || -e "$target" ]] || {
		warn "$target does not exist."
		return "$FALSE"
	}

	read -rp "Are you sure you want to delete '$target'? (yes/N*) "
	[[ "$REPLY" == yes ]] && {
		if rm -rf "$target"; then
			success "$target removed successfully."
			return "$TRUE"
		else
			warn "Could not be remove '$target'."
			return "$FALSE"
		fi
	}
	warn "Operation canceled."
	return "$FALSE"
}

ckxdb_create() {
	local name="$1"

	[[ -z "$name" ]] && {
		warn "Directory name not provided."
		return "$FALSE"
	}

	[[ -d "$name" || -e "$name" || -e "${name}.ckx" ]] && {
		warn "$name already exists."
		return "$FALSE"
	}

	if mkdir "$name"; then
		success "Directory '$name' created."
		return "$TRUE"
	else
		warn "Unable to create directory '$name'."
		return "$FALSE"
	fi
}

# TODO: Improve this
ckxdb_run_shell() {
	local path="$1"
	(
		export HISTFILE="$path/.bash_history"
		export HISTCONTROL=ignoreboth
		export HISTSIZE=100
		exec bash --noprofile --rcfile "$path/.bashrc" -i
	)
}
 
# TODO: Simplify this
ckxdb() {
	[[ -d "$CKX_DEFAULT_DIR" ]] || mkdir -p "$CKX_DATA_DIR"

	builtin cd "$CKX_DATA_DIR"

	declare -g CKXDB_BREAK=1
	local __ckxdb__cmd
	local __ckxdb__cmd_args
	local __ckxdb__arg
	local __ckxdb__target
	local __ckxdb__path
	while :; do
		while (( CKXDB_BREAK )); do
			read -rep 'ckx-database > ' __ckxdb__cmd_args || exit "$TRUE"

			[[ -z "$__ckxdb__cmd_args" ]] && continue

			# shellcheck disable=SC2086
			set -- $__ckxdb__cmd_args
			__ckxdb__cmd="$1"
			__ckxdb__arg="${2%/}"
			__ckxdb__target="${__ckxdb__arg%.ckx}"
			__ckxdb__path="${CKX_DATA_DIR}/${__ckxdb__target}"
			case "${__ckxdb__cmd,,}" in
			h*) ckxdb_help ;;
			l*) ckxdb_list ;;
			cd | sel*) ckxdb_cd "$__ckxdb__arg" ;;
			rm | rem*) ckxdb_rm "$__ckxdb__arg" ;;
			cr*) ckxdb_create "$__ckxdb__arg" ;;
			cl*) clear ;;
			exit) exit "$TRUE" ;;
			*) warn "Invalid command: $__ckxdb__cmd" ;;
			esac
		done

		builtin cd "$__ckxdb__target"

		ckxdb_title
		warn "Close the current shell to encrypt the directory $PWD"
		msg ""

		ckxdb_run_shell "$__ckxdb__path"
		CKXDB_BREAK=1

		builtin cd "$CKX_DATA_DIR"
		ckxdb_encrypt "$__ckxdb__target" && rm -r "$__ckxdb__target"
	done

	exit "$?"
}

