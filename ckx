########################################################################################
#
# encrypt and decrypt
#
########################################################################################

ckx_encrypt() {
	local file="${1%/}"

	[[ -z "$file" ]] && {
		msg "$0 [-e|--encrypt] [FILE|DIR]"
		exit "$FALSE"
	}
	[[ -e "$file" ]] || fatal "$file does not exist."

	[[ -d "$file" ]] && {
		gpg_encrypt_dir "$file" "${file}.tar.gpg" ||
			fatal "An error occurred while encrypting ${file}."
		exit "$TRUE"
	}

	gpg "${CKX_GPG_ENC_OPTS[@]}" -o "${file}.gpg" -c "$file" ||
		fatal "An error occurred while encrypting ${file}."
}

ckx_decrypt() {
	local file="$1"

	[[ -z "$file" ]] && {
		msg "$0 [-d|--decrypt] [FILE.gpg]"
		exit "$FALSE"
	}
	[[ -e "$file" ]] || fatal "$file does not exist."
	[[ -d "$file" || ! "${file##*.}" == "gpg" ]] &&
		fatal "Only GPG files can be decrypted."

	gpg "${CKX_GPG_DEC_OPTS[@]}" -o "${file%.gpg}" -d "$file" ||
		fatal "An error occurred while decrypting ${file}."
}

#----------------------------------------------------------------------------------+
####################################### MAIN #####################################

(( $# == 0 )) && ckxdb

case "$1" in
-h|--help) display_help ;;
-v|--version) display_version ;;
-e|--encrypt) ckx_encrypt "$2" ;;
-d|--decrypt) ckx_decrypt "$2" ;;
-l|--list-vaults) ckxvault_list ;;
*) fatal "invalid option -- $1." "Try '$0 --help' for more information." ;;
esac

exit "$?"

##################################### END MAIN ###################################
#----------------------------------------------------------------------------------+
